  "evidenced_baseline_defects": [
    {
      "category": "continuation_detection",
      "description": "A bare 'tiếp' token marks '(Theo phương pháp trực tiếp)' as a continuation."
    },
    {
      "category": "table_classification",
      "description": "The table-of-contents check searches the substring 'trang' and can collide with 'tình trạng'."
    },
    {
      "category": "table_classification",
      "description": "Broad core-title substring matching assigns core slugs to note tables and inflates source-plus-slug fragmentation counts."
    },
    {
      "category": "unit_detection",
      "description": "Scanning mixed nearby context with percent precedence can override an explicit VND table header."
    },
    {
      "category": "table_classification",
      "description": "Missing financial terms such as 'giá vốn' and 'trả trước' causes false negatives."
    },
    {
      "category": "value_column_selection",
      "description": "Column zero can be selected from a policy classification table, producing paragraph labels with debt-group codes 3 and 4 as values."
    }
  ]
